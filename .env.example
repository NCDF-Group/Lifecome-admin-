# Copy to .env.local for local development: cp .env.example .env.local

# Base URL of the Lifecome-Backen deployment this console talks to - no trailing slash, no
# /api/v1 suffix (see src/config/env.ts and src/app/api/auth/login/route.ts, which append that
# themselves). This is a NEXT_PUBLIC_ var, so it's also required on Vercel at build time, not just
# at runtime - the build fails without it.
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
