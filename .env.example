# Copy to .env.local for local development: cp .env.example .env.local
# Everything here is PUBLIC (exposed to the browser through /runtime-config.js). Never put secrets in it.

# Professional portal origin accepted by the patient bridge. Leave empty to use the current origin.
APP_ORIGIN=

# Full patient application base URL, including path. Leave empty to use <current origin>/patient/.
PATIENT_APP_URL=

# --- Backend ---
# SQLite file (created on first run). Default: ./data/lifecome.db
DATABASE_PATH=
# First super administrator, seeded only while none exists. If the password is blank a random one is
# generated and printed once to the server console.
SEED_SUPERADMIN_EMAIL=superadmin@lifecome.health
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_PASSWORD=
# Optional: send invite emails through Resend. Without these the invite link is shown to copy and share.
RESEND_API_KEY=
MAIL_FROM=
# Invite link lifetime in seconds (default 120)
INVITE_TTL_SECONDS=120
