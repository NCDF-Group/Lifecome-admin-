# Copy to .env.local for local development: cp .env.example .env.local
# Everything here is PUBLIC (exposed to the browser through /runtime-config.js). Never put secrets in it.

# Professional portal origin accepted by the patient bridge. Leave empty to use the current origin.
APP_ORIGIN=

# Full patient application base URL, including path. Leave empty to use <current origin>/patient/.
PATIENT_APP_URL=
