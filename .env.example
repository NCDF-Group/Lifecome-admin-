# Copy to .env.local for local development: cp .env.example .env.local

# Base URL of the Lifecome-Backen deployment this console talks to - no trailing slash, no
# /api/v1 suffix (see src/config/env.ts and src/lib/api/client.ts, which append that themselves).
# Deliberately NOT prefixed NEXT_PUBLIC_: every reader of this is a server-side Route Handler
# (app/api/**/route.ts) - nothing in a "use client" component ever reads it, so it has no reason
# to be exposed to the browser bundle. Still required at build time (src/config/env.ts parses it
# eagerly), so it must be set on Vercel too, not just locally.
API_URL=https://your-backend.onrender.com
