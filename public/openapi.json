  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ClinicalRecord": {
        "type": "object",
        "required": [
          "id",
          "patientId",
          "organisationId",
          "resourceType",
          "version",
          "status",
          "visibility",
          "content",
          "authorId"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "patientId": {
            "type": "string"
          },
          "organisationId": {
            "type": "string"
          },
          "encounterId": {
            "type": "string"
          },
          "resourceType": {
            "type": "string",
            "enum": [
              "observation",
              "consultation",
              "prescription",
              "diagnostic_report",
              "referral",
              "care_summary",
              "wellbeing_plan"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "signed",
              "reviewed",
              "cancelled",
              "amended"
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "professional_only",
              "patient_released",
              "restricted"
            ]
          },
          "content": {
            "type": "object",
            "additionalProperties": true
          },
          "authorId": {
            "type": "string"
          },
          "signedAt": {
            "type": "string",
            "format": "date-time"
          },
          "releasedAt": {
            "type": "string",
            "format": "date-time"
          },
          "supersedesId": {
            "type": "string"
          }
        }
      }
    }
  }
}